# ==============================================================================
# NEXFIELD — Public Demonstration Environment Configuration
# ==============================================================================

# --- Frontend Configuration (apps/web) ---
NEXT_PUBLIC_APP_NAME="NEXFIELD"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Set to 'true' (default) to run as an independent, public agronomic demonstration
# with domain-accurate sample fixtures (data/fixtures/) and localStorage state
NEXT_PUBLIC_USE_FIXTURES="true"

# --- Backend Configuration (services/api - Optional Stateless Utilities) ---
API_PORT=8000
API_HOST="0.0.0.0"
DEBUG=false

# Optional database URL (only needed if running local PostgreSQL with PostGIS migrations)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexfield_db"

# --- AI & Agronomic Model Providers (Optional) ---
AI_MODEL_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
