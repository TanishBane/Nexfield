# ==============================================================================
# NEXFIELD — Root Environment Configuration Template
# NOTE: Never commit live credentials or secret keys to version control.
# Copy this file to .env.local for local overrides.
# ==============================================================================

# --- Frontend Configuration (apps/web) ---
NEXT_PUBLIC_APP_NAME="NEXFIELD"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Set to 'true' to run offline with synthetic agronomic fixtures (data/fixtures/)
# Set to 'false' to connect to live FastAPI backend and Supabase
NEXT_PUBLIC_USE_FIXTURES="true"

# Supabase Client Credentials (Safe for browser / Client-side SDK)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# --- Backend FastAPI Configuration (services/api - Server Only) ---
API_PORT=8000
API_HOST="0.0.0.0"
DEBUG=true

# Supabase PostgreSQL Connection String with PostGIS
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For connection pooling (Transaction Mode): port 6543
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexfield_db"

# Supabase Server-Only Secret Key (NEVER expose to NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_JWT_SECRET="your-project-jwt-secret-from-dashboard"

# --- AI & Agronomic Model Providers ---
AI_MODEL_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
