# ===================================================
# NEXFIELD Root Environment Configuration Template
# ===================================================

# Frontend Development Mode
NEXT_PUBLIC_APP_NAME="NEXFIELD"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
# Set to 'true' to use domain-accurate synthetic fixtures instead of live API
NEXT_PUBLIC_USE_FIXTURES="true"

# Backend FastAPI Configuration (Developer B)
API_PORT=8000
API_HOST="0.0.0.0"
DEBUG=true

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexfield_db"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI / LLM Orchestration
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL_PROVIDER="gemini"
